# Banger Recall: every variable the check-in reads. Copy to .env and fill in what you use.

# Scoring (required for live check-ins and for `bun run bake`; NOT needed for `bun run recall --replay` or `bun run report`)
ANTHROPIC_API_KEY=

# Speech synthesis: say (macOS, offline, default) | openai | silent
TTS_PROVIDER=say
SAY_VOICE=Samantha

# Transcription: local (mlx_whisper, offline, default) | openai
STT_PROVIDER=local
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Only needed when TTS_PROVIDER=openai or STT_PROVIDER=openai
OPENAI_API_KEY=
